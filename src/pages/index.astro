---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

// This safely filters out drafts in production, then sorts everything by date
const posts = (
  await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  })
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BlogLayout title="Blog">
  <section class="masthead">
    <img src="/blog/images/Goguryeo_Samjogo.svg" alt="Thomas Schwartz" width="64" height="64" class="avatar" />
    <div>
      <h1>Languapps Blog</h1>
      <p class="byline">Writing on Language Acquisition &amp; Technology</p>
    </div>
  </section>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`/blog/${post.data.slug ?? post.id}/`}>
          <h2>{post.data.title}</h2>
        </a>
        <div class="post-meta">
          <span class="cluster-tag">{post.data.cluster}</span>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
      </li>
    ))}
  </ul>
</BlogLayout>