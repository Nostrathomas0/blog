---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import avatar from '../assets/thomas-avatar.jpg';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BlogLayout title="Blog">
  <section class="masthead">
    <Image src={avatar} alt="Thomas Schwartz" width={64} height={64} class="avatar" />
    <div>
      <h1>Languapps Blog</h1>
      <p class="byline">Written by Thomas Schwartz — MA TESOL, teacher &amp; builder at Languapps</p>
    </div>
  </section>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`/blog/${post.data.slug ?? post.id}/`}>
          <h2>{post.data.title}</h2>
        </a>
        <div class="post-meta">
          <span class="cluster-tag">{post.data.cluster}</span>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
      </li>
    ))}
  </ul>
</BlogLayout>

<style>
  /* Colors/fonts below are pulled directly from languapps/assets/css/main.css — no new palette invented */
  .masthead {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e6e7;
  }
  .avatar {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .byline {
    font-family: 'Caveat', cursive; /* matches .promo-eyebrow's script font */
    font-size: 1.1rem;
    color: #f35e08; /* brand orange, same as .promo-eyebrow */
    margin: 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .post-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }
  .post-card a {
    text-decoration: none;
    color: #39454b; /* main.css body/title text color */
  }
  .post-card a:hover h2 {
    color: #f35e08;
  }
  .post-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
    color: #39454b;
    opacity: 0.75;
  }
  .cluster-tag {
    /* Follows the same label pattern main.css already applies to
       h1-h4, nav links, and .promo-eyebrow: Oswald, uppercase, tracked-out */
    background: #98c593; /* main.css's existing soft-green accent */
    color: #fff;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-family: 'Oswald', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>