---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const currentTheme = post.data.theme || 'light';
---
<BlogLayout title={post.data.title} theme= {currentTheme}>
  <article>
    <div class="post-meta">
      <span class="cluster-tag">{post.data.cluster}</span>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
    </div>

    {post.data.image && (
      <img src={post.data.image} alt={post.data.image_alt ?? post.data.title} class="hero-image" />
    )}

    <h1>{post.data.title}</h1>

    <div class="author-line">
      <img src="/blog/images/thomas-avatar.jpg" alt={post.data.author} width="40" height="40" class="avatar-small" />
      <div>
        <strong>{post.data.author}</strong>
        {post.data.author_bio && <p class="author-bio">{post.data.author_bio}</p>}
      </div>
    </div>

    <div class="post-content">
      <Content />
    </div>

    {post.data.tags && (
      <div class="tags">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <a href="/blog/" class="cta-button back-link">&larr; Back to all posts</a>
  </article>
</BlogLayout>