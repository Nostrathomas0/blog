---
import '../styles/global.css';
const { title, theme = 'light' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <title>{title} — Languapps Blog</title>
    <script is:inline>
      const root = document.documentElement;
      const assignedTheme = root.getAttribute('data-theme');
      
      if (assignedTheme === 'system') {
        const systemMatchesDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute('data-theme', systemMatchesDark ? 'dark' : 'light');
      }
    </script>
  </head>
  <body class={theme === 'dark' ? 'dark-theme' : ''}>
    <header class="site-header">
      <a href="/blog/" class="site-logo">Languapps</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Languapps — Nice, France</p>
    </footer>
  </body>
</html>

<style>
  :root, [data-theme="light"] {
    --bg-color: #ffffff;
    --text-color: #212529;
    --border-color: #e5e6e7;
    --footer-text: #39454b;
  }

  [data-theme="dark"] {
    --bg-color: #0b0f19;
    --text-color: #f3f4f6;
    --border-color: #1e293b;
    --footer-text: #9ca3af;
  }
  body {
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .site-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #e5e6e7;
  }
  .site-logo {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: #f35e08;
    text-decoration: none;
  }
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .site-footer {
    text-align: center;
    padding: 2rem;
    color: #39454b;
    font-size: 0.85rem;
  }
</style>